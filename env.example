# Postgres. On Railway, set this to the reference: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://user:pass@localhost:5432/khata

# Sign your login cookie. Any long random string; changing it logs everyone out.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string

# Optional. Without it the app falls back to keyword rules and no AI sorting.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. haiku is cheap and fast; switch to claude-sonnet-5 for trickier narrations.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Whether new people can sign up. false locks the instance to existing accounts,
# which is what you want while this is still yours alone.
SIGNUP_ENABLED=false

# Railway sets PORT itself. Only needed locally.
PORT=3000
